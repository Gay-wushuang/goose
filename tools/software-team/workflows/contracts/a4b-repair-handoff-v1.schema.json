{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a4b-repair-handoff-v1.schema.json",
  "title": "A4B_REPAIR_HANDOFF_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "plan_id", "review_id", "repair_attempt", "authorized_files",
    "must_preserve", "repairs", "required_first_action", "forbidden_actions"
  ],
  "properties": {
    "protocol": { "const": "A4B_REPAIR_HANDOFF_V1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "review_id": { "type": "string", "minLength": 1 },
    "repair_attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "authorized_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "must_preserve": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "path", "observed", "required_change", "verification"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^F-[0-9]+$" },
          "path": { "type": "string", "minLength": 1 },
          "observed": { "type": "string", "minLength": 1 },
          "required_change": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_first_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "paths"],
      "properties": {
        "type": { "const": "READ" },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "forbidden_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
